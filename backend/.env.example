# BASE DE DATOS MYSQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=emitours

# GOOGLE OAUTH
GOOGLE_CLIENT_ID=

# CONFIGURACIÓN NODEMAILER / SMTP PARA NOTIFICACIONES POR CORREO
# Para Gmail: host smtp.gmail.com, puerto 587 (secure=false) o 465 (secure=true)
# En SMTP_PASS usar una Contraseña de Aplicación (App Password) de 16 caracteres generada en Google Account
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=
